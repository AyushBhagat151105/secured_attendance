{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "db:seed": "bun run src/modules/auth/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@secured_attendance/auth": "workspace:*",
    "@secured_attendance/db": "workspace:*",
    "@secured_attendance/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "better-auth": "catalog:",
    "bullmq": "^6.1.2",
    "cloudinary": "^2.10.0",
    "dotenv": "catalog:",
    "elysia": "^1.4.29",
    "ioredis": "^6.0.0",
    "papaparse": "^5.6.0",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@secured_attendance/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
