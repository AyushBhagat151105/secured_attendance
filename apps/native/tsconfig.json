{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "server/*": ["../server/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "uniwind-env.d.ts",
    "uniwind-types.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
